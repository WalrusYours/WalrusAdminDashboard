server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # The dashboard is wired to exactly one WALRUS engine at deploy time (like Coolify's
  # control plane, which is the backend it manages). The browser only ever talks to its own
  # origin; /api/ is forwarded to ${WALRUS_UPSTREAM}, so users never type or change a URL.
  #   browser: /api/v1/schema  ->  engine: /v1/schema
  location /api/ {
    proxy_pass ${WALRUS_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 10m;
  }

  location / {
    try_files $uri /index.html;
  }
}
